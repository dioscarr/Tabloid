    },
    {
      "id": "brain-client",
      "direction": "outbound",
      "protocol": "https",
      "path": "https://tabloid-brain-api.tail70b7f1.ts.net/api/v1",
      "purpose": "Brain consumes authorization decisions for tools and skills."
    }
  ],
  "content": {
    "editable": true,
    "surfaces": [
      {
        "id": "policy-guidance",
        "label": "Policy guidance",
        "fields": [
          "title",
          "summary",
          "risk",
          "remediation"
        ]
      }
    ]
  }

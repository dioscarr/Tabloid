{
  "contractVersion": "1.0",
  "app": {
    "id": "astropaper",
    "name": "AstroPaper",
    "branch": "AstroPaper",
    "description": "AstroPaper is Tabloid's clean, source-aware editorial workspace."
  },
  "routes": [
    {
      "id": "brain-content",
      "direction": "outbound",
      "protocol": "https",
      "path": "/api/v1/content",
      "purpose": "Discover, generate, preview, approve, and publish managed page content through Brain."
    },
    {
      "id": "brain-tools",
      "direction": "outbound",
      "protocol": "mcp",
      "path": "/mcp",
      "purpose": "Expose Brain productivity tools to an authenticated server-side agent host."
    }
  ],
  "content": {
    "editable": true,
    "surfaces": [
      {
        "id": "daily-brief",
        "label": "Daily briefing",
        "fields": [
          "headline",
          "takeaways",
          "whyItMatters",
          "sources"
        ]
      }
    ]
  }
}
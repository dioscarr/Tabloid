{
  "contractVersion": "1.0",
  "app": {
    "id": "dashboard",
    "name": "Dashboard",
    "branch": "dashboard",
    "description": "System telemetry, capacity, projections, and application health."
  },
  "routes": [
    {
      "id": "brain-content",
      "direction": "outbound",
      "protocol": "https",
      "path": "/api/v1/content",
      "purpose": "Discover, generate, preview, approve, and publish managed page content through Brain."
    },
    {
      "id": "brain-tools",
      "direction": "outbound",
      "protocol": "mcp",
      "path": "/mcp",
      "purpose": "Expose Brain productivity tools to an authenticated server-side agent host."
    }
  ],
  "content": {
    "editable": true,
    "surfaces": [
      {
        "id": "system-insight",
        "label": "System insight",
        "fields": [
          "title",
          "finding",
          "impact",
          "recommendation"
        ]
      }
    ]
  }
}

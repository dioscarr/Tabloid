# Server-only secrets. Never prefix these with VITE_ and never commit real values.
BRAIN_MCP_TOKEN=replace-with-a-long-random-secret
OPENROUTER_API_KEY=replace-with-an-openrouter-key
# Production uses mounted Podman secrets instead:
# BRAIN_MCP_TOKEN_FILE=/run/secrets/brain_mcp_token
# OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
OPENROUTER_MODELS=cohere/north-mini-code:free,poolside/laguna-s-2.1:free,z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_SITE_URL=https://tabloid-brain-api.tail70b7f1.ts.net
BRAIN_MCP_URL=http://127.0.0.1:8787/mcp
PORT=8787
# Optional persistent store for sanitized topology signals.
BRAIN_TELEMETRY_STORE=/data/telemetry.json

# Server-only secrets. Never prefix these with VITE_ and never commit real values.
BRAIN_MCP_TOKEN=replace-with-a-long-random-secret
BRAIN_ADMIN_TOKEN=replace-with-a-different-long-random-secret
BRAIN_ADMIN_ORIGIN=https://tabloid-admin.tail70b7f1.ts.net
COPILOT_GITHUB_TOKEN=github-user-or-app-token
# Production uses mounted Podman secrets instead:
# BRAIN_MCP_TOKEN_FILE=/run/secrets/brain_mcp_token
# BRAIN_ADMIN_TOKEN_FILE=/run/secrets/brain_admin_token
# COPILOT_GITHUB_TOKEN_FILE=/run/secrets/copilot_token
# The Admin server proxy must send Authorization: Bearer <BRAIN_ADMIN_TOKEN>,
# Origin: <BRAIN_ADMIN_ORIGIN>, and the authenticated user in X-Actor.
# Browser clients are intentionally limited to GET and HEAD requests.
COPILOT_MODEL=gpt-5.4
BRAIN_MCP_URL=http://127.0.0.1:8787/mcp
PORT=8787

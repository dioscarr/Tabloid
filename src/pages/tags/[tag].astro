---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { getPublishedPosts, getTags, slugifyTag } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return getTags(posts).map((tag) => ({ params: { tag: tag.slug }, props: { tag: tag.name } }))
}

const { tag } = Astro.props
const posts = (await getPublishedPosts()).filter((post) => post.data.tags.some((postTag) => slugifyTag(postTag) === slugifyTag(tag)))
---

<BaseLayout title={`${tag} | AstroPaper`} description={`Original AstroPaper posts tagged ${tag}.`}>
  <section class="page-intro">
    <p class="eyebrow">Topic archive</p>
    <h1>{tag}</h1>
    <p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} about {tag.toLowerCase()}.</p>
  </section>
  <section class="content-section content-section--compact" aria-label={`${tag} posts`}>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

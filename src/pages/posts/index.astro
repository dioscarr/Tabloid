---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { getPublishedPosts } from '../../lib/posts'

const posts = await getPublishedPosts()
---

<BaseLayout title="Posts | AstroPaper" description="All original AstroPaper notes about Tabloid, editorial product design, and deployment.">
  <section class="page-intro">
    <p class="eyebrow">The archive</p>
    <h1>All posts</h1>
    <p>Original writing for people building a useful, resilient surface around static branch applications.</p>
  </section>
  <section class="content-section content-section--compact" aria-label="All posts">
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

# Public defaults copied or generated into .env.local for development.
APP_BRANCH=app-gallery
APP_SLUG=app-gallery
VITE_APP_NAME=App Gallery
VITE_APP_ENV=preview
VITE_APP_URL=

# Optional public origin for the Admin API, for example:
# VITE_ADMIN_API_URL=https://admin-api.example
# Leave blank to render the App Gallery unavailable state. This origin serves
# session, application-intent, template, and provisioning requests. Never place
# credentials, tokens, or secrets in a VITE_ variable.
VITE_ADMIN_API_URL=
